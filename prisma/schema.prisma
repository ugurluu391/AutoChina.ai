// AutoChina AI — Prisma Schema
// PostgreSQL + NextAuth (Auth.js v5) + Marketplace modelləri

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== İSTİFADƏÇİ & AUTH =====================

enum Role {
  USER
  SELLER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // credential login üçün (hash)
  role          Role      @default(USER)
  banned        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  seller        Seller?
  wishlist      Wishlist[]
  reviews       Review[]
  orders        Order[]
  aiLogs        AiGenerationLog[]
  chatSessions  ChatSession[]
  payments      Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ===================== SATICI =====================

model Seller {
  id          String   @id @default(cuid())
  userId      String   @unique
  shopName    String
  slug        String   @unique
  description String?
  logo        String?
  banner      String?
  city        String?
  phone       String?
  whatsapp    String? // WhatsApp nömrəsi (məs: 994501234567)
  verified    Boolean  @default(false)
  rating      Float    @default(0)
  aiCredits   Int      @default(5) // AI kreditləri (başlanğıc 5 pulsuz)
  createdAt   DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products     Product[]
  subscription Subscription?
  payments     Payment[]
  creditTxns   CreditTransaction[]
}

// ===================== KATEQORİYA & MARKA =====================

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  icon     String? // emoji və ya icon adı
  products Product[]
}

model CarBrand {
  id       String    @id @default(cuid())
  name     String    @unique // Chery, BYD, Geely...
  slug     String    @unique
  logo     String?
  products Product[]
}

// ===================== MƏHSUL =====================

enum Condition {
  ORIGINAL // Orijinal
  AFTERMARKET // Analoq
  USED // İşlənmiş
}

enum ProductStatus {
  ACTIVE // Aktiv (yayımda)
  DRAFT // Qaralama
  PENDING // Təsdiq gözləyir
  SOLD // Satılıb
  ARCHIVED // Arxivləşdirilib
}

model Product {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  price       Float
  oldPrice    Float?
  images      String[] // Cloudinary URL-lər
  partNumber  String?
  condition   Condition @default(ORIGINAL)
  inStock     Boolean   @default(true)
  stockCount  Int       @default(1)
  rating      Float     @default(0)
  views       Int       @default(0)
  featured    Boolean   @default(false)
  isVip       Boolean   @default(false) // VIP elan (yuxarıda sıralanır)
  vipUntil    DateTime? // VIP müddətinin sonu
  isSponsored Boolean   @default(false) // sponsorlu məhsul
  sponsoredUntil DateTime?
  status      ProductStatus @default(ACTIVE)
  carModel    String? // məs: "Song Plus 2023"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sellerId   String
  categoryId String
  brandId    String

  seller   Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category       @relation(fields: [categoryId], references: [id])
  brand    CarBrand       @relation(fields: [brandId], references: [id])
  reviews  Review[]
  wishlist Wishlist[]
  orderItems OrderItem[]
  productImages ProductImage[]

  @@index([categoryId])
  @@index([brandId])
  @@index([sellerId])
  @@index([status])
  @@index([slug])
}

// Ayrı şəkil modeli — sıralama + Cloudinary metadata
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String // Cloudinary secure_url
  publicId  String // Cloudinary public_id (silmək üçün)
  position  Int      @default(0)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ===================== RƏYLƏR =====================

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ===================== WISHLIST =====================

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ===================== SİFARİŞLƏR =====================

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  total      Float
  status     OrderStatus @default(PENDING)
  address    String?
  phone      String?
  createdAt  DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// ===================== AI GENERASİYA LOGLARI =====================

model AiGenerationLog {
  id          String   @id @default(cuid())
  userId      String? // kim generasiya etdi (anonim də ola bilər)
  // Giriş parametrləri
  productName String
  brand       String?
  carModel    String?
  year        String?
  // AI nəticəsi (JSON kimi saxlanılır)
  title       String?  @db.Text
  description String?  @db.Text
  salesPitch  String?  @db.Text
  hashtags    String[] // massiv
  keywords    String[] // massiv
  // Metadata
  model       String? // istifadə olunan AI modeli
  provider    String   @default("anthropic")
  tokensUsed  Int?
  durationMs  Int?
  success     Boolean  @default(true)
  error       String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// ===================== AI CHAT KÖMƏKÇİSİ =====================

model ChatSession {
  id         String        @id @default(cuid())
  userId     String? // anonim də ola bilər
  language   String        @default("az") // az / ru / en
  totalTokens Int          @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId])
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        ChatRole
  content     String   @db.Text
  reaction    String? // 👍 / 👎 / null
  tokensUsed  Int?
  createdAt   DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ===================== MONETİZASİYA =====================

enum PlanTier {
  FREE // Pulsuz
  PREMIUM // Premium satıcı
  PRO // Pro satıcı
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE // ödəniş gecikib
  TRIALING
  INCOMPLETE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  LOCAL // lokal ödəniş sistemləri (məs: bank kartı/transfer)
}

enum PaymentPurpose {
  SUBSCRIPTION // abunə
  AI_CREDITS // AI kreditləri
  VIP_LISTING // VIP elan
  SPONSORED // sponsorlu məhsul
  FEATURED // seçilmiş məhsul
}

// Abunə (satıcı planı)
model Subscription {
  id                   String             @id @default(cuid())
  sellerId             String             @unique
  tier                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

// Ödəniş qeydi (bütün tranzaksiyalar)
model Payment {
  id              String          @id @default(cuid())
  userId          String?
  sellerId        String?
  amount          Float // AZN
  currency        String          @default("AZN")
  status          PaymentStatus   @default(PENDING)
  provider        PaymentProvider @default(STRIPE)
  purpose         PaymentPurpose
  providerRef     String? // Stripe payment_intent / session id
  metadata        Json? // əlavə kontekst (məhsul id, kredit sayı və s.)
  createdAt       DateTime        @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

// AI kredit tranzaksiyaları (alış + istifadə)
model CreditTransaction {
  id        String   @id @default(cuid())
  sellerId  String
  amount    Int // müsbət = alış, mənfi = istifadə
  reason    String // "purchase", "ai_listing", "bonus"
  createdAt DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}
